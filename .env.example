# ============================================
# Database — Neon Postgres (https://neon.tech)
# ============================================
# 1. Create project at neon.tech
# 2. Copy connection string from "Connection Details"
# 3. Paste here and save as .env
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/elitecarmats?sslmode=require"

# ============================================
# Admin panel — /admin
# ============================================
# REQUIRED. Operator password for the admin login form.
# Must be at least 12 characters. Common passwords ("admin", "password",
# "qwerty", etc.) are rejected. Set this to a long random string in production.
ADMIN_PASSWORD=""

# OPTIONAL. scrypt hash of the password (preferred over storing it in plain
# text in env). Generate with:
#   node -e 'const c=require("crypto");const s=c.randomBytes(16);const h=c.scryptSync(process.argv[1],s,64);console.log(`scrypt:${s.toString("hex")}:${h.toString("hex")}`)' "yourpassword"
# When set, ADMIN_PASSWORD is ignored.
ADMIN_PASSWORD_HASH=""

# REQUIRED in production. HMAC secret used to sign admin session cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, sessions are signed with a key derived from ADMIN_PASSWORD —
# rotating the password also invalidates every active session.
SESSION_SECRET=""

# OPTIONAL. Bearer token for `x-admin-token` header on diagnostic endpoints
# (/api/admin/migrate, /api/admin/seed) — useful for curl from a terminal.
# When unset, only browser cookie auth is accepted. Min 16 chars.
ADMIN_API_TOKEN=""

# ============================================
# Email — Resend (https://resend.com)
# ============================================
# If RESEND_API_KEY is not set, emails will be logged to console only.
# 1. Sign up at resend.com (free tier: 3000 emails/month)
# 2. Create API key and paste here
# 3. Verify the elitecarmats.us domain in Resend dashboard
#    (add the DNS records in Vercel → Domains → DNS)
RESEND_API_KEY=""

# Sender address. Must be from a verified domain.
# Before domain is verified, use: "EliteCarMats <onboarding@resend.dev>"
EMAIL_FROM="EliteCarMats <orders@elitecarmats.us>"

# Where new order notifications go
OWNER_EMAIL="info@elitecarmats.us"

# ============================================
# Site URL — used in email links
# ============================================
NEXT_PUBLIC_SITE_URL="https://elitecarmats.us"

# ============================================
# Stripe — payments (optional)
# ============================================
# When STRIPE_SECRET_KEY is unset, the checkout falls back to a manual-
# confirm flow.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ============================================
# Order tracking — HMAC secret for /order/<num> URLs
# ============================================
# Used to sign per-order tokens so customers can view their own order
# without authentication, but a stranger guessing the order number cannot.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_TOKEN_SECRET=""

# ============================================
# Rate limiting — Upstash Redis (optional but strongly recommended)
# ============================================
# In-memory fallback works for dev/single-region only — on serverless each
# lambda has its own counter, so brute force protection is effectively zero.
# 1. Create a Redis database at https://upstash.com (free tier)
# 2. Copy the REST URL + token below
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
