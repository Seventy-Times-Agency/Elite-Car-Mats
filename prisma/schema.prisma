generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Автомобили
// ============================================

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models    Model[]
}

model Model {
  id        String    @id @default(cuid())
  name      String
  slug      String
  bodyType  String?
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  years     ModelYear[]
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([brandId, slug])
  @@index([brandId])
}

model ModelYear {
  id      String @id @default(cuid())
  year    Int
  modelId String
  model   Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, year])
}

// ============================================
// Продукты
// ============================================

enum MatSetType {
  FRONT
  FULL
  CARGO
  FULL_CARGO
}

model Product {
  id        String     @id @default(cuid())
  modelId   String
  model     Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  matSet    MatSetType
  price     Decimal?   @db.Decimal(10, 2)
  images    String[]
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orderItems OrderItem[]

  @@unique([modelId, matSet])
}

// ============================================
// Цвета
// ============================================

model EvaColor {
  id        String      @id @default(cuid())
  name      String
  hex       String
  image     String?
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  orderItems OrderItem[]
}

model EdgeColor {
  id        String      @id @default(cuid())
  name      String
  hex       String
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  orderItems OrderItem[]
}

// ============================================
// Шильдики (бейджи)
// ============================================

model Badge {
  id        String      @id @default(cuid())
  brandName String
  image     String?
  price     Decimal?    @db.Decimal(10, 2)
  active    Boolean     @default(true)
  orderItems OrderItem[]
}

// ============================================
// Заказы
// ============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  status                OrderStatus @default(PENDING)
  customerName          String
  phone                 String
  email                 String
  address               String
  city                  String?
  state                 String?
  zip                   String?
  comment               String?
  total                 Decimal?    @db.Decimal(10, 2)
  trackingNumber        String?
  // Stripe integration (optional — populated once payments are turned on)
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model OrderItem {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  colorId     String
  color       EvaColor   @relation(fields: [colorId], references: [id])
  edgeColorId String
  edgeColor   EdgeColor  @relation(fields: [edgeColorId], references: [id])
  badgeId     String?
  badge       Badge?     @relation(fields: [badgeId], references: [id])
  // Aluminum heel pad — driver-side reinforced metal plate add-on.
  // Flat $17 upcharge regardless of mat set; persisted per-item so
  // we can re-render the original configuration on the order page
  // and so the Stripe webhook can describe the line-item correctly.
  heelPad     Boolean    @default(false)
  year        Int?
  quantity    Int        @default(1)
  price       Decimal?   @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@index([colorId])
  @@index([edgeColorId])
  @@index([badgeId])
}

// ============================================
// Отзывы
// ============================================

model Review {
  id           String   @id @default(cuid())
  customerName String
  carModel     String
  text         String
  rating       Int      @default(5)
  photos       String[]
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([approved, createdAt])
}

// ============================================
// Промокоды
// ============================================

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  discount    Int       // percentage 1-100
  description String?
  maxUses     Int?      // null = unlimited
  usedCount   Int       @default(0)
  minOrder    Decimal?  @db.Decimal(10, 2)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([active])
}

// ============================================
// Индивидуальные заказы (custom-order form)
// ============================================

enum CustomOrderStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}

model CustomOrderRequest {
  id         String            @id @default(cuid())
  name       String
  email      String
  phone      String
  make       String
  model      String
  year       String
  bodyType   String?
  matSet     String?
  notes      String?
  locale     String?
  status     CustomOrderStatus @default(NEW)
  adminNotes String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status, createdAt])
}

// Stripe webhook idempotency ledger. One row per processed event id —
// claimed via INSERT ... ON CONFLICT DO NOTHING in the webhook handler.
model WebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

// ============================================
// Newsletter
// ============================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

// ============================================
// Blog
// ============================================

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String    // Markdown
  coverImage  String?   // optional URL
  published   Boolean   @default(false)
  publishedAt DateTime?
  // Locale of the post body. For v1 posts are single-locale; the public
  // /blog page only shows posts whose locale matches the visitor's
  // active language (or all languages if locale is null = "neutral").
  locale      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([locale])
}

// ============================================
// Price overrides
// ============================================
//
// Admin-editable per-(profile, matSet) price overrides. The code-based
// price table in src/data/catalog/mat-sets.ts remains the source of truth
// for the public storefront's *display* (cart drawer, product page etc.
// run client-side and read prices synchronously). Server-side billing
// paths — /api/orders, /api/checkout/stripe, the Stripe webhook —
// load overrides from this table and pass them through to
// calculateItemUnitPrice so customers are always billed at the latest
// price. After admin saves a change, the public storefront catches
// up at the next Vercel redeploy.

model MatSetPriceOverride {
  id        String   @id @default(cuid())
  profile   String   // VehicleConfigProfile: standard | pickup | twoSeater | semi | minivan
  matSet    String   // MatSetType: front | full | cargo | full-cargo
  price     Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([profile, matSet])
}

// ============================================
// Custom catalog (admin-managed extras)
// ============================================
//
// The bulk of the catalog (~60 brands, ~700 models) lives in code at
// src/data/catalog/. These tables let admins add brands or models that
// aren't in code without a redeploy. Public catalog read paths merge:
//   code-based brands/models  +  CustomBrand / CustomModel rows
// Slug uniqueness is enforced inside this DB scope only — pre-existing
// code-based slugs aren't in this table, so a clash would only surface
// at merge time (we filter customs whose slug collides with code).

model CustomBrand {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  logo        String?
  popularity  Int?
  // VehicleCategory list (car / suv / truck / commercial). Stored as a
  // simple string array — no enum, since we already store the same
  // category string under Model.bodyType for code-based rows.
  categories  String[]      @default([])
  models      CustomModel[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
}

model CustomModel {
  id        String       @id @default(cuid())
  brandId   String
  brand     CustomBrand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  bodyType  String
  // VehicleCategory: car | suv | truck | commercial
  category  String
  // Comma-separated year list, e.g. "2020,2021,2022,2023". Kept as
  // a single string (rather than int[]) to match the pattern used by
  // the existing code-based ModelYear/years[] formats.
  years     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([brandId, slug])
  @@index([brandId])
}
